{
  "buildCommand": "pnpm build",
  "outputDirectory": "src/.vuepress/dist",
  "installCommand": "pnpm install --frozen-lockfile",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/gh/(.*)",
      "destination": "https://raw.githubusercontent.com/$1"
    },
    {
      "source": "/bing/(.*)",
      "destination": "/api/proxy"
    }
  ]
}
